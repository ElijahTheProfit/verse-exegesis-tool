{
  "name": "verse-exegesis-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "comment": "Scripts call binaries via 'node ./node_modules/...' instead of the bin shims, because the project path contains an '&' that Windows cmd.exe treats as a command separator and which corrupts npm's shim paths. These relative invocations are shell-agnostic and work identically on Render/Linux and at any clean path.",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k -n client,server -c blue,green \"node ./node_modules/vite/bin/vite.js\" \"node ./node_modules/tsx/dist/cli.mjs watch server/server.ts\"",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "start": "node ./node_modules/tsx/dist/cli.mjs server/server.ts",
    "build:data": "node ./node_modules/tsx/dist/cli.mjs scripts/build-data.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/literata": "^5.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
